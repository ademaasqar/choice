import pandas as pd
from sklearn.preprocessing import StandardScaler
from sklearn.linear_model import LogisticRegression
from sklearn.neural_network import MLPClassifier
from sklearn.metrics import accuracy_score, precision_score, recall_score, f1_score, confusion_matrix

rows = [
(1,.20,.10,.80,.10,1),(2,.30,.20,.70,.20,1),(3,.40,.15,.90,.15,1),(4,.50,.30,.80,.10,1),
(5,.60,.25,.75,.20,1),(6,.70,.35,.85,.10,1),(7,.80,.40,.90,.15,1),(8,.25,.50,.70,.40,1),
(9,.35,.45,.80,.35,1),(10,.45,.55,.75,.45,1),(11,.55,.50,.85,.30,1),(12,.65,.60,.80,.40,1),
(13,.20,.80,.40,.75,0),(14,.30,.70,.35,.80,0),(15,.40,.85,.45,.70,0),(16,.50,.75,.30,.85,0),
(17,.60,.90,.40,.80,0),(18,.70,.80,.35,.90,0),(19,.80,.85,.45,.75,0),(20,.90,.70,.30,.85,0),
(21,.25,.90,.50,.80,0),(22,.45,.95,.40,.90,0),(23,.65,.85,.30,.95,0),(24,.85,.90,.35,.85,0)]
df = pd.DataFrame(rows, columns=["ID","Vibration","Slip","SurfaceGrip","ObstacleRate","Stable"])
feat = ["Vibration","Slip","SurfaceGrip","ObstacleRate"]
tr, te = df[df.ID <= 18], df[df.ID >= 19]
sc = StandardScaler().fit(tr[feat])
Xtr, Xte = sc.transform(tr[feat]), sc.transform(te[feat])
ytr, yte = tr.Stable.values, te.Stable.values

def report(name, pred):
    kw = dict(pos_label=0, zero_division=0)   # оң класс = Тұрақсыз
    print(name, accuracy_score(yte, pred), precision_score(yte, pred, **kw),
          recall_score(yte, pred, **kw), f1_score(yte, pred, **kw))
    print(confusion_matrix(yte, pred, labels=[0, 1]))

report("LogReg", LogisticRegression(random_state=42).fit(Xtr, ytr).predict(Xte))
for lr in [0.01, 0.001, 0.0001]:
    nn = MLPClassifier(hidden_layer_sizes=(8,), learning_rate_init=lr,
                       max_iter=500, random_state=42).fit(Xtr, ytr)
    report(f"NN lr={lr}", nn.predict(Xte))
